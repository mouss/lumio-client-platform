# Copier ce fichier en .env puis remplir les valeurs.
# .env n'est jamais committé.

# Base de données locale (Prisma + SQLite)
DATABASE_URL="file:./dev.db"

# URL publique de la plateforme, utilisée pour construire les liens /offres/[token] et /espace/[token]
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Webhook Calendly : clé de signature fournie par Calendly, sert à vérifier que l'appel vient bien de Calendly
CALENDLY_WEBHOOK_SIGNING_KEY=""

# Accès à /admin
ADMIN_PASSWORD_HASH=""

# Envoi des emails (Nodemailer)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM=""
