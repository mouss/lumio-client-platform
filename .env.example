# Copier ce fichier en .env puis remplir les valeurs.
# .env n'est jamais committé.

# Base de données locale (Prisma + SQLite)
DATABASE_URL="file:./dev.db"

# Envoi des emails (Nodemailer)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""

# Accès à /admin
ADMIN_PASSWORD=""

# Dossier de stockage des PDF d'audit. Vide = ./uploads à la racine du projet.
UPLOADS_DIR=""

# URL publique de la plateforme, sert à construire les liens /offres/[token], /espace/[token] et /onboarding/[token]
APP_URL="http://localhost:3000"

# Webhook Calendly : clé de signature, et identifiant du type d'événement utilisé pour les rendez-vous d'audit
CALENDLY_WEBHOOK_SIGNING_KEY=""
CALENDLY_AUDIT_EVENT_URI=""
